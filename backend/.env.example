# Backend Environment Variables
# MongoDB connection string
MONGODB_URI=mongodb+srv://mongodb/SecondBrain

# Secret used by better-auth for signing/encrypting sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=rep1ace-with-a-1ong-random-secret

# Public URL this backend is reachable at (used to build OAuth callback URLs).
BACKEND_URL=http://localhost:3001

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: {BACKEND_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL for CORS - replace with your production frontend URL
FRONTEND_URL=http://localhost:5173
