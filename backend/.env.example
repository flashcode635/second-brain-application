# Backend Environment Variables
# MongoDB connection string
MONGODB_URI=mongodb+srv://mongodb/SecondBrain

# Use two distinct secure random strings in production
ACCESS_TOKEN_SECRET=replace-with-a-long-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-refresh-secret

# Frontend URL for CORS - replace with your production frontend URL
FRONTEND_URL=http://localhost:5173

