# Frontend Environment Variables
# Backend URL - replace with your production backend URL
VITE_BACKEND_URL=http://localhost:3001

# Show Google sign-in/sign-up buttons only when set to "true".
# Accepted values: true or false (defaults to false when unset).
VITE_GOOGLE_SIGNUP_ENABLED=false

# For production, set this to your actual backend URL:
# VITE_BACKEND_URL=https://your-backend-domain.com
